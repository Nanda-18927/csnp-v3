# Crime Sight Noir - outbound mail
# Copy to .env and fill in. Leave CSN_SMTP_HOST empty and the app still
# works: messages are printed to the server console instead.

CSN_SMTP_HOST=
CSN_SMTP_PORT=587
CSN_SMTP_USER=
CSN_SMTP_PASS=
CSN_SMTP_FROM=

# Where new-FIR notifications go (comma separated).
CSN_NOTIFY_OFFICIALS=

# Public base URL used in reset links.
CSN_PUBLIC_URL=http://127.0.0.1:4000
